#include <winver.h>

1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040C04B0"
		BEGIN
			VALUE "CompanyName", "Lanppart3"
			VALUE "FileDescription", "Celaria Lanppart3 - launcher LAN (mod Coupe / Time Attack)"
			VALUE "FileVersion", "2.0"
			VALUE "ProductName", "Celaria Lanppart3"
			VALUE "ProductVersion", "2.0"
			VALUE "OriginalFilename", "Celaria Lanppart3.exe"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x040C, 1200
	END
END
